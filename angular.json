{
  "cli": {
    "analytics": false
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "rangertrak": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "rangertrak",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/rangertrak",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["src/polyfills.ts"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "favicon.ico",
                "input": "./src/assets/icons",
                "output": "./"
              },
              {
                "glob": "_headers",
                "input": "./src",
                "output": "./"
              },
              {
                "glob": "robots.txt",
                "input": "./src",
                "output": "./"
              },
              {
                "glob": "**/*",
                "input": "./src/assets",
                "output": "./assets",
                "ignore": [
                  "data/secrets.json"
                ]
              },
              "src/manifest.webmanifest",
              {
                "glob": "**/*",
                "input": "node_modules/leaflet/dist/images/",
                "output": "./assets/imgs"
              },
              {
                "glob": "maplibre-gl-{worker,shared}.mjs",
                "input": "node_modules/maplibre-gl/dist/",
                "output": "./assets/maplibre"
              },
              {
                "glob": "**/*",
                "input": "./src/command-post-view",
                "output": "./view"
              },
              "src/manifest.webmanifest"
            ],
            "styles": [
              "./node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
              "./node_modules/leaflet.markercluster/dist/MarkerCluster.css",
              "./node_modules/leaflet/dist/leaflet.css",
              "./node_modules/maplibre-gl/dist/maplibre-gl.css",
              "./src/styles.scss"
            ],
            "scripts": [],
            "serviceWorker": "ngsw-config.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "1mb",
                  "maximumError": "1mb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": {
                "fonts": {
                  "inline": true
                },
                "styles": {
                  "inlineCritical": false
                }
              },
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true
            },
            "profiling": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "1mb",
                  "maximumError": "1mb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": {
                "fonts": {
                  "inline": true
                },
                "styles": {
                  "//": "inlineCritical MUST stay false while the CSP is enforcing (2026-09-22). It makes Angular emit the compiled stylesheet as <link media=\"print\" onload=\"this.media='all'\">, and an enforcing script-src blocks inline EVENT HANDLERS - a hash cannot cover one without 'unsafe-hashes'. The stylesheet then never activates: the app renders unstyled and /map overflows a phone viewport. Caught by e2e once tools/serve-dist.js began applying src/_headers.",
                  "inlineCritical": false
                }
              },
              "outputHashing": "all",
              // 2026-08-29: same optimized/minified output as "production" (real-world
              // DevTools traces need production's actual bundle shape, not dev's unminified
              // one), but with real .map files so Chrome can attribute minified execution
              // back to source instead of dumping it in an "[unattributed]" bucket - the gap
              // that showed up chasing a PageSpeed Insights report. `hidden: true` omits the
              // `//# sourceMappingURL` comment so DevTools only picks these up when manually
              // pointed at them, not automatically for a random visitor with DevTools open -
              // but that is NOT a real access control, just a discoverability one, and this
              // repo's `wrangler.jsonc` deploys its ENTIRE build output directory as public
              // static assets with no exclusion mechanism. `production` above (the one
              // `npm run build` / CI actually uses to deploy - see package.json,
              // deploy.yml) deliberately keeps `sourceMap: false` untouched, so a real
              // deploy never produces `.map` files to leak in the first place. Use
              // `ng build --configuration profiling` (or `npm run build:profiling`) for a
              // local-only build to load into DevTools when investigating performance -
              // never deploy this configuration's output.
              "sourceMap": {
                "scripts": true,
                "styles": true,
                "hidden": true
              },
              "namedChunks": false,
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "rangertrak:build:production"
            },
            "development": {
              "buildTarget": "rangertrak:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "rangertrak:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": ["src/polyfills.ts"],
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/assets/icons/favicon.ico",
              "src/manifest.webmanifest",
              "src/manifest.webmanifest",
              "src/assets/forms/ics-213.pdf"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}

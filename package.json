{
  "name": "rangertrak",
  "version": "1.0.0-beta.1",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:profiling": "ng build --configuration profiling",
    "test": "ng test",
    "test:worker": "node --test worker/index.test.mjs",
    "test:board": "node --test \"tools/board/*.test.js\"",
    "server": "node tools/serve-dist.js",
    "command-post": "node tools/command-post-server.js",
    "e2e": "node tools/e2e.js",
    "e2e:full": "node tools/e2e.js --full",
    "e2e:prod": "node tools/e2e.js --base=https://rangertrak.org --read-only --full",
    "e2e:offline": "node tools/e2e-offline-map.js",
    "backup-fixture": "node tools/make-backup-fixture.js",
    "check:secrets": "node tools/check-no-secrets.js",
    "check:regional": "node tools/check-regional-tools.js",
    "check:storage": "node tools/check-storage-inventory.js",
    "check:icons": "node tools/icon-font/scan.js --check",
    "test:regional": "node tools/regional/demo/test-demo-region.js && node tools/regional/demo/test-make-montecito-demo.js && node tools/regional/demo/test-make-oso-demo.js",
    "deploy": "run-s build check:secrets deploy:only",
    "deploy:only": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "release": "standard-version",
    "compodoc": "npx compodoc -p tsconfig.doc.json --theme=Vagrant",
    "style": "prettier --check \"src/**/*.{ts,scss,css,html}\" \"worker/**/*.{js,mjs}\"",
    "style:fix": "prettier --write \"src/**/*.{ts,scss,css,html}\" \"worker/**/*.{js,mjs}\"",
    "lint": "run-p lint:ts lint:tsc",
    "lint:fix": "run-s lint:ts:fix lint:tsc",
    "lint:ts": "eslint \"src/**/*.{ts,html}\"",
    "lint:ts:fix": "eslint --fix \"src/**/*.{ts,html}\"",
    "lint:tsc": "tsc --noEmit --skipLibCheck -p tsconfig.app.json && tsc --noEmit --skipLibCheck -p tsconfig.spec.json",
    "init:env": "init-dev-env generate-dot-env example.env -f"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@material/banner": "^14.0.0",
    "@material/icon-button": "^14.0.0",
    "@material/slider": "^14.0.0",
    "@material/switch": "^14.0.0",
    "@material/top-app-bar": "^14.0.0",
    "@mdi/js": "^7.4.47",
    "@types/core-js": "^2.5.8",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "ag-grid-angular": "^36.1.0",
    "ag-grid-community": "^36.1.0",
    "ajv": "^8.17.1",
    "crypto-js": "^4.2.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "leaflet.offline": "^3.2.0",
    "maplibre-gl": "^6.16.0",
    "mediabunny": "^1.62.1",
    "mgrs": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pmtiles": "^4.5.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "tslib": "^2.8.1",
    "utm": "^1.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@types/google.maps": "^3.66.6",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.6.5",
    "@types/utm": "^1.1.4",
    "acorn": "^8.15.0",
    "angular-eslint": "^22.6.0",
    "cross-conf-env": "^1.3.0",
    "dev-norms": "^2.0.4",
    "eslint": "^10.12.0",
    "http-server": "^14.1.1",
    "init-dev-env": "^2.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.2",
    "tsviz-cli": "^2.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "vite": "8.3.5"
  },
  "importSort": {
    ".ts, .tsx": {
      "parser": "typescript",
      "style": "module",
      "options": {}
    }
  }
}

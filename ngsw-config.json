{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "templates",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/templates/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "!/assets/maps/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "exercise",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/exercise/**"
        ]
      }
    },
    {
      "name": "tour",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/tour/**"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/exercise",
    "!/exercise/",
    "!/tour",
    "!/tour/",
    "!/self-hosting",
    "!/self-hosting/"
  ],
  "dataGroups": [
    {
      "name": "api_randomuser.me",
      "urls": [
        "https://api.randomuser.me/?reesults*"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "2d"
      }
    }
  ]
}

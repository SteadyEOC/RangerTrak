    family-names: Cornelison
    orcid: "https://orcid.org/0009-0000-5516-3956"
repository-code: "https://github.com/SteadyEOC/RangerTrak"
url: "https://rangertrak.org"
license: AGPL-3.0-or-later
version: 1.0.0-beta.3
date-released: "2026-11-13"
keywords:
  - emergency management
  - CERT
  - ARES
  - search and rescue
  - ICS-309
  - offline-first
  - PWA
